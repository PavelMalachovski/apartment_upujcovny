{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "tour",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/three.min.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
